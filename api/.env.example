DATABASE_URL=postgresql+psycopg://tutor_tds:troque-esta-senha@db:5432/tutor_tds
POSTGRES_PASSWORD=
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
# Opcional no desenvolvimento direto; obrigatório no compose de produção.
PUBLIC_API_BASE_URL=
JWT_SECRET=
CPF_PEPPER=
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
GOOGLE_SHEET_ID=
# Worker legado só é iniciado com --profile sheets-sync; não substitui o export
# agregado da jornada. Mesmo com worker desligado, a API requer pseudônimo estável
# quando JOURNEY_TRACEABILITY_ENABLED=true.
GOOGLE_SHEET_RANGE=EventosAPI!A:J
# Use apenas uma das opções abaixo. JSON deve ser injetado como secret.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_FILE=
SHEETS_PSEUDONYM_SECRET=
SYNC_BATCH_SIZE=100
SYNC_POLL_SECONDS=30
SYNC_MAX_ATTEMPTS=3
SYNC_LEASE_SECONDS=300
CERTIFICATE_VERIFICATION_URL_PREFIX=
CLOUDFLARE_STREAM_DELIVERY_BASE_URL=
COMMERCIAL_SIMULATION_ENABLED=false
PAYMENT_ADAPTER=disabled
LEARNING_CONTEXT_ENABLED=false
JOURNEY_TRACEABILITY_ENABLED=false
