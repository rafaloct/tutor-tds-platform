# Copie para STAGING_DEPLOY_PATH/.env e preencha somente no host de staging.
STAGING_POSTGRES_PASSWORD=
STAGING_ALLOWED_ORIGINS=
STAGING_JWT_SECRET=
STAGING_CPF_PEPPER=
STAGING_API_PORT=8001

STAGING_TRAEFIK_ENABLED=false
STAGING_PUBLIC_HOST=ead.ipexdesenvolvimento.cloud
STAGING_PUBLIC_PATH=/tutor-staging-api
STAGING_PUBLIC_API_BASE_URL=https://ead.ipexdesenvolvimento.cloud/tutor-staging-api

# O QA de DB/API não depende de Google Sheets.
STAGING_SHEETS_SYNC_ENABLED=false
STAGING_GOOGLE_SHEET_ID=
STAGING_GOOGLE_SHEET_RANGE=EventosAPI-Staging!A:J
STAGING_GOOGLE_SERVICE_ACCOUNT_JSON=
STAGING_SHEETS_PSEUDONYM_SECRET=

STAGING_CERTIFICATE_VERIFICATION_URL_PREFIX=
STAGING_CLOUDFLARE_STREAM_DELIVERY_BASE_URL=
STAGING_COMMERCIAL_SIMULATION_ENABLED=false
STAGING_LEARNING_CONTEXT_ENABLED=false
STAGING_JOURNEY_TRACEABILITY_ENABLED=false
