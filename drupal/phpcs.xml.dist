<?xml version="1.0" encoding="UTF-8"?>
<ruleset name="tds-drupal">
  <description>Padrao Drupal para codigo customizado do portal TDS.</description>

  <file>web/modules/custom</file>
  <file>web/themes/custom</file>

  <arg name="extensions" value="php,module,inc,install,test,profile,theme,engine"/>
  <arg name="colors"/>
  <arg value="sp"/>

  <rule ref="Drupal"/>
  <rule ref="DrupalPractice"/>
</ruleset>
