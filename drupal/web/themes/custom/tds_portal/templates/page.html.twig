{#
/**
 * @file
 * Template de pagina do tema TDS Portal (fundacao DR-2).
 */
#}
<a class="tds-skip-link" href="#main-content">Ir para o conteudo principal</a>

<div class="layout-container">

  <header role="banner" class="tds-header">
    {{ page.header }}
  </header>

  {% if page.primary_menu %}
    <nav class="tds-primary-nav" aria-label="Navegacao principal">
      {{ page.primary_menu }}
    </nav>
  {% endif %}
  {{ page.secondary_menu }}
  {{ page.breadcrumb }}
  {{ page.highlighted }}
  {{ page.help }}

  <main role="main" class="tds-main">
    <a id="main-content" tabindex="-1"></a>
    {{ page.content }}
  </main>

  {% if page.footer %}
    <footer role="contentinfo" class="tds-footer">
      {{ page.footer }}
    </footer>
  {% endif %}

</div>
