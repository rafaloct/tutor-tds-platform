# Portal Drupal Tutor TDS — ambiente local (DR-2 / Issue #163)
# Copie para .env antes do primeiro bootstrap: cp .env.example .env
# NUNCA comitar .env real. Em staging/producao estes valores vem do
# gerenciador de segredos do ambiente, nunca do Git.

# Ambiente declarativo: local | staging (producao e HUMAN-GATE, fora de escopo)
DRUPAL_ENVIRONMENT=local

# Banco EXCLUSIVO do Drupal (MariaDB dedicado, servico "db" do compose).
# E proibido apontar para o PostgreSQL do Tutor TDS (docs/drupal/ARCHITECTURE.md).
DRUPAL_DB_DRIVER=mysql
DRUPAL_DB_HOST=db
DRUPAL_DB_PORT=3306
DRUPAL_DB_NAME=drupal
DRUPAL_DB_USER=drupal
DRUPAL_DB_PASSWORD=drupal-dev-only
DRUPAL_DB_ROOT_PASSWORD=drupal-root-dev-only

# Salt de hash do Drupal: valor fraco aceito SOMENTE em dev local descartavel.
DRUPAL_HASH_SALT=troque-este-salt-em-qualquer-ambiente-real

# Padroes de host confiavel (regex separados por virgula).
DRUPAL_TRUSTED_HOSTS=^localhost$,^127\.0\.0\.1$,^web$

# Porta HTTP publicada no host.
DRUPAL_HTTP_PORT=8080

# Interface de bind da porta publicada. Padrao loopback (so o host alcanca).
# Para teste AUTORIZADO em LAN/Tailscale, alargue explicitamente:
#   DRUPAL_HTTP_BIND=0.0.0.0        # todas as interfaces (LAN)
#   DRUPAL_HTTP_BIND=100.x.y.z      # IP Tailscale desta maquina
DRUPAL_HTTP_BIND=127.0.0.1

# Conta administrativa do primeiro site:install (apenas dev local).
DRUPAL_ADMIN_USER=admin
DRUPAL_ADMIN_PASSWORD=admin-dev-only

# URL base da API Tutor TDS usada pelo BFF (vazio = portal ainda sem integracao).
# Em staging: https://tutor-tds-staging.fastapicloud.dev
TUTOR_API_BASE_URL=
