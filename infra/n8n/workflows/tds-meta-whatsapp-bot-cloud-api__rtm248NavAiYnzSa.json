      "id": "v",
      "name": "Verify",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -680,
        180
      ],
      "parameters": {
        "jsCode": "const qs = $input.first().json.query || {};\nif (qs['hub.mode'] === 'subscribe' && qs['hub.verify_token'] === 'tds_campo_2026') {\n  return [{ json: { challenge: qs['hub.challenge'] || 'ok' } }];\n}\nreturn [{ json: { challenge: '' } }];",
        "mode": "runOnceForAllItems"
      }
    },
    {
      "id": "rv",
      "name": "Responder Challenge",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        -460,
        180
      ],
      "parameters": {
        "respondWith": "text",
        "responseBody": "={{ $json.challenge }}",
        "options": {
          "responseCode": 200
        }
      }
    },
    {
      "id": "em",
      "name": "Extrair Meta",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -680,
        420
      ],
      "parameters": {
        "jsCode": "const body = $input.item.json.body || {};\nconst value = body?.entry?.[0]?.changes?.[0]?.value || {};\nconst msgs = value?.messages || [];\nif (!msgs.length) return [];\nconst msg = msgs[0];\nconst wamid = msg?.id || '';\nconst text = msg?.text?.body || '';\nconst from = msg?.from || '';\nif (!text || !from || !wamid) return [];\nreturn [{ json: { msg_id: 'meta_' + wamid, phoneNumber: from, messageText: text, channel:'meta' } }];",
        "mode": "runOnceForAllItems"
      }
    },
    {
      "id": "Dedup wamid",
      "name": "Dedup wamid",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        -460,
        420
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "=INSERT INTO tds_dedup (msg_id) VALUES ('{{ $json.msg_id }}') ON CONFLICT (msg_id) DO NOTHING RETURNING msg_id"
      },
      "credentials": {
        "postgres": {
