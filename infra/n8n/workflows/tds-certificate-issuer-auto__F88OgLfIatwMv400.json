  "nodes": [
    {
      "id": "n1",
      "name": "Webhook Enrollment Complete",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        200,
        300
      ],
      "parameters": {
        "path": "tds-enrollment-complete",
        "httpMethod": "POST",
        "responseMode": "responseNode",
        "options": {}
      },
      "webhookId": "a3f6c8e8-18ff-43e2-8654-d902c3434231"
    },
    {
      "id": "n2",
      "name": "Extrair Dados",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        420,
        300
      ],
      "parameters": {
        "jsCode": "const body = $input.first().json.body || $input.first().json;\nconst phone = (body.whatsapp || body.phone || '').replace(/[^0-9]/g, '');\nconst courseSlug = body.course_slug || body.courseSlug || '';\nconst studentName = body.student_name || body.name || 'Aluno';\nif (!phone || !courseSlug) throw new Error('Dados insuficientes');\nreturn [{ json: { phone, courseSlug, studentName } }];"
      }
    },
    {
      "id": "n3",
      "name": "Emitir Certificado OPS",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        640,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api-lms.ipexdesenvolvimento.cloud/issue_cert",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Admin-Key",
              "value": "admin-tds-2026"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "whatsapp",
              "value": "={{ .phone }}"
            },
            {
              "name": "course_slug",
              "value": "={{ .courseSlug }}"
            }
          ]
        },
        "options": {}
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "id": "n4",
      "name": "Montar Mensagem",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        860,
        300
      ],
      "parameters": {
        "jsCode": "const cert = $input.first().json;\nconst ex = $(\"Extrair Dados\").first().json;\nconst certId = cert.cert_id || cert.certificate_hash || cert.id || '';\nif (!certId) throw new Error('Cert nao emitido: ' + JSON.stringify(cert));\nconst url = 'https://api-lms.ipexdesenvolvimento.cloud/validate_cert/' + certId;\nconst cn = cert.course_name || cert.course || ex.courseSlug;\nconst msg = '🎓 *Parabens, ' + ex.studentName + '!*\n\nVoce concluiu o curso! 🏅\n\n📘 *Curso:* ' + cn + '\n🔐 *Hash:* ' + certId + '\n\n🔗 *Acesse seu certificado:*\n' + url + '\n\n_Programa TDS_';\nreturn [{ json: { phone: ex.phone, certId, message: msg } }];"
      }
    },
    {
      "id": "n5",
      "name": "Notificar WhatsApp",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        1080,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "https://evolution.ipexdesenvolvimento.cloud/message/sendText/tds_suporte_audiovisual",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": []
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "number",
              "value": "={{ .phone }}"
            },
            {
              "name": "text",
              "value": "={{ .message }}"
            },
            {
              "name": "linkPreview",
              "value": false
            }
          ]
        },
        "options": {},
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "credentials": {
        "httpHeaderAuth": {
          "id": "tdsEvoCred001x",
          "name": "TDS Evolution apikey"
        }
      }
    },
    {
      "id": "n6",
      "name": "Resposta OK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        1300,
        300
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\"status\":\"ok\",\"cert_id\":\"{{ $json.certId }}\"}"
      }
    }
  ],
