            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Comando?": {
      "main": [
        [
          {
            "node": "RAG Worker",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    },
    "RAG Worker": {
      "main": [
