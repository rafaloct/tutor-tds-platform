  "name": "TDS — Notificacao Aulas",
  "description": "Cron diário às 8h: busca aulas nas próximas 24h, formata lembrete por aluno e envia WhatsApp via Chatwoot API (busca contato + cria conversa).",
  "active": true,
  "isArchived": false,
  "nodes": [
    {
      "id": "e2b19d60-731b-4c5a-ac3d-76362a75b846",
      "name": "Cron 8h Diario",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [
        240,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "daysInterval": 1,
              "triggerAtHour": 8,
              "triggerAtMinute": 0
            }
          ]
        }
      }
    },
    {
      "id": "2b480f73-f782-4c14-956c-96f89f70ec38",
      "name": "Buscar Aulas e Alunos",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        480,
        300
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT a.id AS aula_id, a.titulo, a.data_hora, a.link_meet, t.nome AS turma_nome, t.curso, al.id AS aluno_id, al.nome AS aluno_nome, al.telefone FROM aulas a JOIN turmas t ON t.id = a.turma_id JOIN matriculas m ON m.turma_id = t.id JOIN alunos al ON al.id = m.aluno_id WHERE a.data_hora BETWEEN NOW() + INTERVAL '20 hours' AND NOW() + INTERVAL '26 hours' AND m.status = 'ativa' AND al.telefone IS NOT NULL ORDER BY a.data_hora, al.nome"
      },
      "credentials": {
        "postgres": {
          "id": "dxU0dZ2Fe1yaJhGg",
          "name": "PostgreSQL - Kreativ"
        }
      }
    },
    {
      "id": "06389264-e1ff-4001-aed8-a79b2b299831",
      "name": "Formatar Mensagens",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "return $input.all().map(function(item) { var dh = new Date(item.json.data_hora); var dia = dh.toLocaleDateString('pt-BR', { timeZone: 'America/Araguaina', day: '2-digit', month: '2-digit' }); var hora = dh.toLocaleTimeString('pt-BR', { timeZone: 'America/Araguaina', hour: '2-digit', minute: '2-digit' }); var mensagem = 'Olá, ' + item.json.aluno_nome + '!\\n\\nLembrete: sua aula de *' + item.json.curso + '* é amanhã!\\n\\n📅 *Data:* ' + dia + '\\n⏰ *Hora:* ' + hora + '\\n📖 *Aula:* ' + item.json.titulo + '\\n\\n🔗 *Link Meet:* ' + item.json.link_meet + '\\n\\nAté lá! 👋'; return { json: Object.assign({}, item.json, { mensagem: mensagem }) }; });"
      }
    },
    {
      "id": "bd2635ef-2c2e-4243-8ea4-d2f5da7ba927",
      "name": "Notificacoes Enviadas",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        960,
        100
      ],
      "parameters": {}
    },
    {
      "id": "c2301286-4a86-41f2-ad00-82baed527a34",
      "name": "Loop Por Aluno",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
