      ],
      "parameters": {
        "batchSize": 1
      }
    },
    {
      "id": "enviar-evolution-api-node",
      "name": "Enviar Evolution API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        1200,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "https://evolution.ipexdesenvolvimento.cloud/message/sendText/tds_suporte_audiovisual",
        "sendHeaders": true,
        "specifyHeaders": "keypair",
        "headerParameters": {
          "parameters": []
        },
        "sendBody": true,
